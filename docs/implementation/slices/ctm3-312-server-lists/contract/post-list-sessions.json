{
  "request": {
    "method": "POST",
    "path": "/api/lists/sessions/",
    "headers": {
      "Content-Type": "application/json",
      "X-CSRFToken": "<csrftoken cookie>"
    },
    "body": {
      "page": 1,
      "size": 50,
      "sort": [],
      "q": "",
      "filters": {
        "view": "upcoming"
      }
    }
  },
  "response": {
    "status": 200,
    "body": {
      "items": [
        {
          "id": "3e4f5a6b-7c8d-4e9f-8a0b-1c2d3e4f5a6b",
          "date": "2026-11-14",
          "reference": "CS20261114",
          "starts_at": "2026-11-14T10:00:00-08:00",
          "presiding_member_id": "6a7b8c9d-0e1f-4a2b-8c3d-4e5f6a7b8c9d",
          "presiding_member_name": "Demo Presiding Member",
          "location": "Demo Hall",
          "adjourned_at": null,
          "assigned_case_count": 4,
          "hearing_case_count": 2,
          "state": "planned",
          "can_edit": true,
          "can_delete": false
        }
      ],
      "page": 1,
      "size": 50,
      "total": 1,
      "has_more": false
    }
  },
  "note": "items use the existing session_data projection unchanged (capability keys come from session_capabilities).",
  "errors": [
    {
      "when": "not signed in",
      "status": 401,
      "body": {
        "error": "authentication_required"
      }
    },
    {
      "when": "GET or another method",
      "status": 405,
      "body": {
        "error": "method_not_allowed"
      }
    },
    {
      "when": "CSRF header missing or wrong",
      "status": 403,
      "body": {
        "detail": "CSRF Failed"
      }
    },
    {
      "when": "unknown list name, e.g. /api/lists/drafts/",
      "status": 404,
      "body": {
        "error": "resource_or_input_invalid"
      }
    },
    {
      "when": "page not an integer from 1 to 1000000",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "page must be an integer from 1 to 1000000."
        ]
      }
    },
    {
      "when": "size not an integer from 1 to 100",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "size must be an integer from 1 to 100."
        ]
      }
    },
    {
      "when": "sort field not allowed for this list and role",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Unsupported sort field: <field>."
        ]
      }
    },
    {
      "when": "more than 3 sort entries or dir not asc/desc",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Use up to 3 sort entries, each with dir asc or desc."
        ]
      }
    },
    {
      "when": "q shorter than 2 or longer than 200 characters after trimming (empty is allowed)",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Search text must be 2 to 200 characters."
        ]
      }
    },
    {
      "when": "filter key not allowed for this list and role",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Unsupported filter: <key>."
        ]
      }
    },
    {
      "when": "unknown top-level body key",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Unsupported list option: <key>."
        ]
      }
    },
    {
      "when": "applicant",
      "status": 403,
      "body": {
        "error": "forbidden",
        "detail": "Council access required."
      }
    },
    {
      "when": "filters.view not current, upcoming or archived",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "view must be current, upcoming or archived."
        ]
      }
    },
    {
      "when": "filters.date_from after filters.date_to",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "date_from must not follow date_to."
        ]
      }
    }
  ]
}
