{
  "request": {
    "method": "POST",
    "path": "/api/lists/applications/",
    "headers": {
      "Content-Type": "application/json",
      "X-CSRFToken": "<csrftoken cookie>"
    },
    "body": {
      "page": 1,
      "size": 50,
      "sort": [],
      "q": "",
      "filters": {
        "state": "awaiting_review"
      }
    }
  },
  "response": {
    "status": 200,
    "body": {
      "items": [
        {
          "id": "9a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
          "kind": "petition",
          "origin": "portal",
          "requires_new_information": false,
          "status": "submitted",
          "case_id": "7f3c2a10-5b1e-4c55-9a51-0c6f1d2e8a01",
          "case_number": "20261020-04",
          "filing_party_id": "5c6d7e8f-9a0b-4c1d-8e2f-3a4b5c6d7e8f",
          "filing_party_name": "Demo Mina Applicant",
          "filing_party_role": "applicant",
          "version": 3,
          "answers": {
            "marriage_date": "2015-06-20"
          },
          "fee": {
            "amount_minor": 15000,
            "currency": "usd",
            "status": "paid"
          },
          "submitted_at": "2026-10-20T17:04:00+00:00",
          "applicant_name": "Demo Mina Applicant"
        }
      ],
      "page": 1,
      "size": 50,
      "total": 1,
      "has_more": false
    }
  },
  "note": "items use the existing application_data projection unchanged; the example shows only some answers.",
  "errors": [
    {
      "when": "not signed in",
      "status": 401,
      "body": {
        "error": "authentication_required"
      }
    },
    {
      "when": "GET or another method",
      "status": 405,
      "body": {
        "error": "method_not_allowed"
      }
    },
    {
      "when": "CSRF header missing or wrong",
      "status": 403,
      "body": {
        "detail": "CSRF Failed"
      }
    },
    {
      "when": "unknown list name, e.g. /api/lists/drafts/",
      "status": 404,
      "body": {
        "error": "resource_or_input_invalid"
      }
    },
    {
      "when": "page not an integer from 1 to 1000000",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "page must be an integer from 1 to 1000000."
        ]
      }
    },
    {
      "when": "size not an integer from 1 to 100",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "size must be an integer from 1 to 100."
        ]
      }
    },
    {
      "when": "sort field not allowed for this list and role",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Unsupported sort field: <field>."
        ]
      }
    },
    {
      "when": "more than 3 sort entries or dir not asc/desc",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Use up to 3 sort entries, each with dir asc or desc."
        ]
      }
    },
    {
      "when": "q shorter than 2 or longer than 200 characters after trimming (empty is allowed)",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Search text must be 2 to 200 characters."
        ]
      }
    },
    {
      "when": "filter key not allowed for this list and role",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Unsupported filter: <key>."
        ]
      }
    },
    {
      "when": "unknown top-level body key",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Unsupported list option: <key>."
        ]
      }
    },
    {
      "when": "applicant sends filters.state or a non-empty q",
      "status": 403,
      "body": {
        "error": "forbidden",
        "detail": "Council access required."
      }
    },
    {
      "when": "filters.state not awaiting_review or council_consideration",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "state must be awaiting_review or council_consideration."
        ]
      }
    },
    {
      "when": "filters.case not a UUID",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "case must be a case id."
        ]
      }
    }
  ]
}
