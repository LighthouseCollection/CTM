{
  "request": {
    "method": "POST",
    "path": "/api/lists/audit/",
    "headers": {
      "Content-Type": "application/json",
      "X-CSRFToken": "<csrftoken cookie>"
    },
    "body": {
      "page": 1,
      "size": 50,
      "sort": [
        {
          "field": "created_at",
          "dir": "desc"
        }
      ],
      "q": "decree",
      "filters": {
        "source": "tribunal.decree",
        "date_from": "2026-11-01",
        "date_to": "2026-11-01"
      },
      "facets": true
    }
  },
  "response": {
    "status": 200,
    "body": {
      "items": [
        {
          "id": "1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d",
          "action": "decree_released",
          "source": "tribunal.decree",
          "timestamp": "2026-11-02T07:59:00+00:00"
        }
      ],
      "page": 1,
      "size": 50,
      "total": null,
      "has_more": false,
      "facets": {
        "action": [
          "decree_released",
          "session_closed"
        ],
        "source": [
          "tribunal.councilsession",
          "tribunal.decree"
        ]
      }
    }
  },
  "note": "total is always null: audit rows pass audit_visible() in Python, so a SQL count could include hidden rows. date_from/date_to are Los Angeles civil days; 2026-11-02T07:59Z is 2026-11-01 23:59 PST. facets is present only when the request sets facets: true and page is 1.",
  "errors": [
    {
      "when": "not signed in",
      "status": 401,
      "body": {
        "error": "authentication_required"
      }
    },
    {
      "when": "GET or another method",
      "status": 405,
      "body": {
        "error": "method_not_allowed"
      }
    },
    {
      "when": "CSRF header missing or wrong",
      "status": 403,
      "body": {
        "detail": "CSRF Failed"
      }
    },
    {
      "when": "unknown list name, e.g. /api/lists/drafts/",
      "status": 404,
      "body": {
        "error": "resource_or_input_invalid"
      }
    },
    {
      "when": "page not an integer from 1 to 1000000",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "page must be an integer from 1 to 1000000."
        ]
      }
    },
    {
