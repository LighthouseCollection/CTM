{
  "request": {
    "method": "POST",
    "path": "/api/lists/accounts/",
    "headers": {
      "Content-Type": "application/json",
      "X-CSRFToken": "<csrftoken cookie>"
    },
    "body": {
      "page": 2,
      "size": 25,
      "sort": [
        {
          "field": "created_at",
          "dir": "desc"
        }
      ],
      "q": "",
      "filters": {
        "role": "applicant"
      }
    }
  },
  "response": {
    "status": 200,
    "body": {
      "items": [
        {
          "id": "8c9d0e1f-2a3b-4c4d-8e5f-6a7b8c9d0e1f",
          "name": "Demo Applicant",
          "email": "applicant@example.org",
          "role": "applicant",
          "active": true,
          "email_verified": true,
          "ui_language": "ar",
          "notification_language": "ar",
          "created_at": "2026-09-02T18:11:00+00:00",
          "status_version": 0,
          "can_suspend": true,
          "can_reactivate": false,
          "status_history_url": "/api/system/accounts/8c9d0e1f-2a3b-4c4d-8e5f-6a7b8c9d0e1f/status-history/"
        }
      ],
      "page": 2,
      "size": 25,
      "total": 26,
      "has_more": false
    }
  },
  "errors": [
    {
      "when": "not signed in",
      "status": 401,
      "body": {
        "error": "authentication_required"
      }
    },
    {
      "when": "GET or another method",
      "status": 405,
      "body": {
        "error": "method_not_allowed"
      }
    },
    {
      "when": "CSRF header missing or wrong",
      "status": 403,
      "body": {
        "detail": "CSRF Failed"
      }
    },
    {
      "when": "unknown list name, e.g. /api/lists/drafts/",
      "status": 404,
      "body": {
        "error": "resource_or_input_invalid"
      }
    },
    {
      "when": "page not an integer from 1 to 1000000",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "page must be an integer from 1 to 1000000."
        ]
      }
    },
    {
      "when": "size not an integer from 1 to 100",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "size must be an integer from 1 to 100."
        ]
      }
    },
    {
      "when": "sort field not allowed for this list and role",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Unsupported sort field: <field>."
        ]
      }
    },
    {
      "when": "more than 3 sort entries or dir not asc/desc",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Use up to 3 sort entries, each with dir asc or desc."
        ]
      }
    },
    {
      "when": "q shorter than 2 or longer than 200 characters after trimming (empty is allowed)",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Search text must be 2 to 200 characters."
        ]
      }
    },
    {
      "when": "filter key not allowed for this list and role",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Unsupported filter: <key>."
        ]
      }
    },
    {
      "when": "unknown top-level body key",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Unsupported list option: <key>."
        ]
      }
    },
    {
      "when": "actor is not admin or secretary",
      "status": 403,
      "body": {
        "error": "forbidden",
        "detail": "Administrator or secretary required."
      }
    },
    {
      "when": "filters.role not applicant, member, president, secretary or admin",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Unsupported account role filter."
        ]
      }
    }
  ]
}
