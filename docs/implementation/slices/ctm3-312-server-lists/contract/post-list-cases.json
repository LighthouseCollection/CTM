{
  "request": {
    "method": "POST",
    "path": "/api/lists/cases/",
    "headers": {
      "Content-Type": "application/json",
      "X-CSRFToken": "<csrftoken cookie>"
    },
    "body": {
      "page": 1,
      "size": 50,
      "sort": [
        {
          "field": "number",
          "dir": "desc"
        }
      ],
      "q": "Mina",
      "filters": {
        "status": "open"
      }
    }
  },
  "response": {
    "status": 200,
    "body": {
      "items": [
        {
          "id": "7f3c2a10-5b1e-4c55-9a51-0c6f1d2e8a01",
          "number": "20261020-04",
          "status": "open",
          "display_status": "open",
          "assigned_member_id": "2b8e6f40-1c2d-4e5f-8a9b-0c1d2e3f4a5b",
          "assigned_member": "Fr. Demo Member",
          "applicant_gender": "F",
          "respondent_gender": "M",
          "applicant_name": "Demo Mina Applicant",
          "respondent_name": "Demo Respondent",
          "grounds": [
            "abandonment"
          ],
          "reason": "abandonment",
          "closed_at": null,
          "party_names": [
            "Demo Mina Applicant",
            "Demo Respondent"
          ],
          "next_step": "case.next.hearing"
        }
      ],
      "page": 1,
      "size": 50,
      "total": 1,
      "has_more": false
    }
  },
  "errors": [
    {
      "when": "not signed in",
      "status": 401,
      "body": {
        "error": "authentication_required"
      }
    },
    {
      "when": "GET or another method",
      "status": 405,
      "body": {
        "error": "method_not_allowed"
      }
    },
    {
      "when": "CSRF header missing or wrong",
      "status": 403,
      "body": {
        "detail": "CSRF Failed"
      }
    },
    {
      "when": "unknown list name, e.g. /api/lists/drafts/",
      "status": 404,
      "body": {
        "error": "resource_or_input_invalid"
      }
    },
    {
      "when": "page not an integer from 1 to 1000000",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "page must be an integer from 1 to 1000000."
        ]
      }
    },
    {
      "when": "size not an integer from 1 to 100",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "size must be an integer from 1 to 100."
        ]
      }
    },
    {
      "when": "sort field not allowed for this list and role",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Unsupported sort field: <field>."
        ]
      }
    },
    {
      "when": "more than 3 sort entries or dir not asc/desc",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Use up to 3 sort entries, each with dir asc or desc."
        ]
      }
    },
    {
      "when": "q shorter than 2 or longer than 200 characters after trimming (empty is allowed)",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Search text must be 2 to 200 characters."
        ]
      }
    },
    {
      "when": "filter key not allowed for this list and role",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Unsupported filter: <key>."
        ]
      }
    },
    {
      "when": "unknown top-level body key",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "Unsupported list option: <key>."
        ]
      }
    },
    {
      "when": "applicant sends filters.mine, filters.assigned, filters.ground or a council-only sort field",
      "status": 403,
      "body": {
        "error": "forbidden",
        "detail": "Council access required."
      }
    },
    {
      "when": "filters.status not open, closed or any",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "status must be open, closed or any."
        ]
      }
    },
    {
      "when": "filters.ids not a list of 1 to 100 UUIDs",
      "status": 422,
      "body": {
        "error": "validation",
        "messages": [
          "ids must list 1 to 100 case ids."
        ]
      }
    }
  ]
}
