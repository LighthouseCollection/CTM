{
  "cases": [
    {
      "note": "Over 2 MB (2097152 bytes). Checked on the bytes received, before anything is parsed or stored.",
      "actor": "secretary",
      "request": {
        "method": "POST",
        "path": "/api/council/photos/2b8e6f40-1c2d-4e5f-8a9b-0c1d2e3f4a5b/",
        "headers": {
          "Content-Type": "multipart/form-data; boundary=<boundary>",
          "X-CSRFToken": "<csrftoken cookie>"
        },
        "body": {
          "photo": "<file: big.jpg, image/jpeg, 2097153 bytes>",
          "expected_version": 4
        }
      },
      "response": {
        "status": 422,
        "body": {
          "error": "photo_too_large",
          "max_bytes": 2097152
        }
      }
    },
    {
