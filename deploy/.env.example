# CTM Docker Compose environment
# Copy to .env and fill in real values before deploying.
# Never commit .env to version control.

# --- PostgreSQL ---
POSTGRES_DB=ctm
POSTGRES_USER=ctm_owner
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- PostgreSQL runtime roles (non-owner, RLS-subject) ---
CTM_APP_PASSWORD=CHANGE_ME_STRONG_PASSWORD
CTM_WORKER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Meilisearch ---
MEILI_MASTER_KEY=CHANGE_ME_STRONG_KEY_32_CHARS_MIN

# --- Django ---
DJANGO_SECRET_KEY=CHANGE_ME_RANDOM_50_CHARS
DJANGO_ALLOWED_HOSTS=ctm.lighthouseway.org,localhost,10.0.0.40
DJANGO_CSRF_TRUSTED_ORIGINS=https://ctm.lighthouseway.org
DJANGO_DEBUG=false
# Enable only after restricting origin port8000 to the trusted HTTPS reverse proxy.
CTM_TRUST_PROXY_SSL=false
# Optional Engram profile; dedicated DB role, never CTM owner credentials.
ENGRAM_DB_PASSWORD=

# --- Identity providers (configure before live use) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Payments (Stripe test mode for demo) ---
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# --- Engram Cloud (developer memory — NOT a CTM dependency) ---
# Uses a separate 'engram_cloud' database on the shared postgres instance.
# CTM application services have NO connection to Engram.
ENGRAM_IMAGE=ghcr.io/gentleman-programming/engram:v2.0.0
ENGRAM_CLOUD_TOKEN=CHANGE_ME_LONG_RANDOM_BEARER_TOKEN
ENGRAM_CLOUD_ADMIN=CHANGE_ME_SEPARATE_ADMIN_TOKEN
ENGRAM_JWT_SECRET=CHANGE_ME_32_BYTE_RANDOM_SECRET
ENGRAM_CLOUD_ALLOWED_PROJECTS=ctm
