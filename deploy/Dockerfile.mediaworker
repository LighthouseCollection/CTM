FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        ffmpeg \
        curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 1000 ctm && useradd -u 1000 -g ctm -m ctm

WORKDIR /app

COPY deploy/requirements.txt deploy/requirements-mediaworker.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-mediaworker.txt

COPY manage.py /app/manage.py
COPY ctm /app/ctm
COPY tribunal /app/tribunal
COPY static /app/static

USER ctm
