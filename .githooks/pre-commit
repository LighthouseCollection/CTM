#!/bin/sh
# CTM pre-commit gate (SDLC phase 3, G3). Enable once per checkout:
#   git config core.hooksPath .githooks
# Fast checks only (seconds). CI runs the full gate set.
set -e
root="$(git rev-parse --show-toplevel)"
cd "$root"

node scripts/check_frontend_contract.cjs --base HEAD
node scripts/check_ownership.cjs --base HEAD

# Keep AGENTS.md generated from CLAUDE.md.
if git diff --cached --name-only | grep -q '^CLAUDE.md$'; then
  node scripts/sync_agent_rules.cjs
  git add AGENTS.md
fi

# Semgrep on staged files when it is installed (CI always runs it).
if command -v semgrep >/dev/null 2>&1; then
  files=$(git diff --cached --name-only --diff-filter=ACM)
  if [ -n "$files" ]; then
    # shellcheck disable=SC2086
    semgrep scan --config .semgrep/ctm.yml --error --quiet $files
  fi
fi
